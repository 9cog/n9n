# Node9 AI Model Configuration
# 
# NOTE: If you're using GitHub Copilot or GitHub Actions:
# - MODEL_KEY is already configured in GitHub secrets
# - You don't need to create a .env file
# - This file is for local development/testing only
#
# Copy this file to .env and fill in your API keys for local use

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Generic Model Configuration
MODEL_KEY=your_model_api_key_here
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o

# Local Model Configuration (e.g., Ollama)
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama2

# Model Parameters
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2000
